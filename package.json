{
  "name": "deepseek-harness-shell",
  "productName": "DeepSeek Harness Shell",
  "version": "0.1.2",
  "description": "DeepSeek Harness Shell —— 基于 Electron + Vite + Vue3 + Element Plus 的桌面外壳，通过 `dsh web` 启动 DeepSeek Harness Web UI 并用 <webview> 内嵌展示。",
  "license": "Apache-2.0",
  "author": "XEonSKY Studio",
  "main": "./out/main/index.js",
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true,
    "@electron/rebuild": true
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "reinstall":"node node_modules/electron/install.js",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:x64": "npm run build && electron-builder --win --x64",
    "dist:win:arm64": "npm run build && electron-builder --win --arm64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:x64": "npm run build && electron-builder --linux --x64",
    "dist:linux:arm64": "npm run build && electron-builder --linux --arm64"
  },
  "dependencies": {},
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^26.4.1",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.3.9",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "semver": "^7.8.5",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.deepseek.harness.shell",
    "productName": "DeepSeek Harness Shell",
    "executableName": "dsh_shell",
    "publish": {
      "provider": "github",
      "owner": "XEonSKY",
      "repo": "DeepSeek-Harness-Shell"
    },
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "!**/.vscode/*",
      "!src/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "DeepSeek-Harness-Shell-${version}-win-${arch}-setup.${ext}",
      "shortcutName": "DeepSeek Harness Shell"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Shell-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "artifactName": "DeepSeek-Harness-Shell-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "executableName": "deepseek-harness-shell"
    },
    "appImage": {
      "artifactName": "DeepSeek-Harness-Shell-${version}-linux-${arch}.${ext}"
    }
  }
}